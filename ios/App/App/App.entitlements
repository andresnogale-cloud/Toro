<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal links: replace YOUR-DOMAIN with your site. Enable it in Xcode under
	     Signing & Capabilities > + Capability > Associated Domains (needs a paid Apple developer account). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:YOUR-DOMAIN</string>
	</array>
</dict>
</plist>
